{
  "name": "@toantranmei/comments",
  "version": "0.0.0",
  "description": "Notion-style comments (marks, gutter badges, side panel, threads) for @toantranmei/editor.",
  "keywords": ["vue", "tiptap", "notion", "comments", "editor", "collaboration"],
  "license": "MIT",
  "author": "toantranmei",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toantranmei/editor.git",
    "directory": "packages/comments"
  },
  "homepage": "https://github.com/toantranmei/editor#readme",
  "bugs": { "url": "https://github.com/toantranmei/editor/issues" },
  "type": "module",
  "files": ["dist", "README.md", "LICENSE"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": { "types": "./dist/types/index.d.ts", "import": "./dist/index.js" },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": ["**/*.css"],
  "scripts": {
    "build": "node ../editor/scripts/check-styles.mjs src && vite build && vue-tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "check:styles": "node ../editor/scripts/check-styles.mjs src",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@lucide/vue": "^1.61.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/vue-3": "3.32.0",
    "@toantranmei/editor": "^0.3.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@lucide/vue": "^1.61.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/vue-3": "3.32.0",
    "@toantranmei/editor": "workspace:*",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "21.0.4",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "5.0.5",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0",
    "yjs": "^13.6.0"
  },
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=20" }
}

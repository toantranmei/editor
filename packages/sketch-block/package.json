{
  "name": "@toantranmei/sketch-block",
  "version": "0.0.0",
  "description": "Optional whiteboard block for @toantranmei/editor.",
  "keywords": [
    "vue",
    "tiptap",
    "whiteboard",
    "sketch",
    "excalidraw",
    "editor",
    "block"
  ],
  "license": "MIT",
  "author": "toantranmei",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toantranmei/editor.git",
    "directory": "packages/sketch-block"
  },
  "homepage": "https://github.com/toantranmei/editor#readme",
  "bugs": {
    "url": "https://github.com/toantranmei/editor/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./providers": {
      "types": "./dist/types/providers/index.d.ts",
      "import": "./dist/providers.js"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && node scripts/check-entry.mjs",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@lucide/vue": "^1.61.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/vue-3": "3.32.0",
    "@toantranmei/editor": ">=0.2.0 <1.0.0",
    "vue": "^3.5.0",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.0"
  },
  "dependencies": {
    "fractional-indexing": "4.0.0",
    "nanoid": "6.0.2",
    "rbush": "4.0.1",
    "roughjs": "4.6.6",
    "y-indexeddb": "9.0.12"
  },
  "devDependencies": {
    "@fontsource/patrick-hand": "5.3.0",
    "@lucide/vue": "^1.61.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/vue-3": "3.32.0",
    "@toantranmei/editor": "workspace:*",
    "@types/node": "^26.6.5",
    "@types/rbush": "4.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.4.6",
    "fake-indexeddb": "6.2.6",
    "happy-dom": "21.0.4",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "5.0.5",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependenciesMeta": {
    "y-protocols": {
      "optional": true
    }
  }
}
